# Base de datos (PostgreSQL)
DATABASE_URL=postgres://usuario:clave@localhost:5432/burrow_labs
TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/burrow_labs_test

# URL pública del sitio (canonical, sitemap, Open Graph). En producción, con https:// y sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth del admin. AUTH_SECRET: openssl rand -hex 32 (obligatoria en producción, mínimo 32 caracteres)
AUTH_SECRET=
# Usuario inicial que crea `pnpm db:seed` (solo si no existe). Contraseña de 12 caracteres o más.
# Después del primer arranque en producción: borrar estas dos líneas del .env del servidor y cambiar la
# contraseña desde el panel (Mi cuenta). Ver docs/SECURITY.md.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Solo Docker (docker-compose.yml): contraseña del PostgreSQL del contenedor. openssl rand -hex 24
# POSTGRES_PASSWORD=

# Storage de media: local | s3
STORAGE_DRIVER=local
# Solo para STORAGE_DRIVER=s3 (S3, R2, MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Analytics (opcional: si están vacías no se carga ningún tracker)
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity (grabaciones y mapas de calor): ID del proyecto. Igual que GA, solo se carga tras «Aceptar».
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
# IndexNow (Bing y otros): clave propia, `openssl rand -hex 16`. Vacía = no se avisa a buscadores.
INDEXNOW_KEY=

# Burrow Prospect (herramienta interna) lee consultas y fichas por /api/prospect/sync con este token.
# Mínimo 32 caracteres (openssl rand -hex 32); el mismo valor va en BURROWLABS_API_TOKEN de Prospect. Vacío = la ruta no existe.
PROSPECT_API_TOKEN=

# Muestra borradores demo con cinta «DEMO» (solo desarrollo; en producción se ignora)
SHOW_DEMO_CONTENT=false

# Correo (newsletter y respuestas a consultas): log (por defecto: no envía; registra el asunto y un
# identificador del destinatario, nunca su email) | smtp | resend | brevo
# EMAIL_FROM es obligatoria con cualquier envío real: no hay remitente por defecto (ver README, «Variables de entorno»).
# - smtp: SMTP_HOST obligatoria; SMTP_PORT (465 = TLS implícito, por defecto; otro puerto = STARTTLS);
#   SMTP_USER y SMTP_PASSWORD juntas, o ninguna si el servidor autoriza por IP.
# - resend o brevo: EMAIL_API_KEY y el dominio del remitente verificado en el proveedor.
# EMAIL_DRIVER=log
# EMAIL_FROM=Tu Marca <hola@tu-dominio.example>
# EMAIL_FROM_NEWSLETTER=Tu Marca <novedades@tu-dominio.example>   # opcional: remitente de bienvenida y campañas
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_API_KEY=

# El archivo .env del servidor guarda secretos: chmod 600 .env
